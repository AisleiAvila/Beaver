{
  "name": "loja-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "ng lint",
    "clean": "node clean-cache.js",
    "clean-start": "node clean-cache.js && timeout /t 2 /nobreak >nul && ng serve",
    "reset": "node force-clean.js && ng serve",
    "iniciar": "iniciar-limpo.bat",
    "start-no-hmr": "ng serve --no-hmr",
    "iniciar-sem-hmr": "iniciar-limpo.bat --no-hmr",
    "download-models": "ts-node src/app/utils/download-models.ts"
  },
  "private": true,
